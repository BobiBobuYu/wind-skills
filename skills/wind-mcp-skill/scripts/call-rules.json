{
  "schema_version": 20,
  "description": "只保留 schema 表达不了的规则：跨字段约束、指数 K 线周期映射、代码字段归一化键、纯文本错误前缀。必填、类型、枚举以 tool-manifest.json 为准。",
  "kline_period_map": {
    "1min": "1",
    "5min": "3",
    "10min": "4",
    "15min": "5",
    "30min": "6",
    "60min": "7",
    "120min": "8",
    "240min": "9",
    "1d": "10",
    "1w": "11",
    "1mo": "12",
    "1y": "13",
    "1q": "14",
    "6mo": "15"
  },
  "kline_tools": [
    "get_index_kline"
  ],
  "code_keys": [
    "windcode",
    "windCode",
    "windCodes"
  ],
  "text_error_prefixes": [
    "Invalid ",
    "未识别到有效的金融标的",
    "缺少必填参数",
    "服务暂时不可用",
    "余额不足"
  ],
  "tool_rules": [
    {
      "name": "index_kline",
      "label": "指数 K 线",
      "tools": [
        "get_index_kline"
      ],
      "ordered_dates": [
        [
          "begin_date",
          "end_date"
        ]
      ],
      "enum_fields": {
        "period": {
          "values_from": "kline_period_map",
          "message": "字段 'period' 只能是 ${values}，日 K 请传 '1d'"
        }
      }
    },
    {
      "name": "index_quote",
      "label": "指数分钟行情",
      "tools": [
        "get_index_quote"
      ],
      "ordered_dates": [
        [
          "begin",
          "end"
        ]
      ]
    },
    {
      "name": "edb_series",
      "label": "EDB 取数",
      "tools": [
        "economic_query_indicator_series"
      ],
      "paired": [
        [
          "startDate",
          "endDate"
        ]
      ],
      "mutually_exclusive": [
        [
          "observation",
          "startDate"
        ],
        [
          "observation",
          "endDate"
        ]
      ],
      "ordered_dates": [
        [
          "startDate",
          "endDate"
        ]
      ]
    },
    {
      "name": "edb_series_by_code",
      "label": "EDB 按代码取数",
      "tools": [
        "economic_get_indicator_series"
      ],
      "paired": [
        [
          "startDate",
          "endDate"
        ]
      ],
      "mutually_exclusive": [
        [
          "numOfObservation",
          "startDate"
        ],
        [
          "numOfObservation",
          "endDate"
        ]
      ],
      "ordered_dates": [
        [
          "startDate",
          "endDate"
        ]
      ]
    },
    {
      "name": "start_end_order",
      "label": "日期区间",
      "tools": [
        "fund_get_similar_funds",
        "fund_get_style_analysis",
        "fund_get_return_attribution",
        "options_get_contract_series",
        "options_get_variety_series",
        "options_get_variety_stats",
        "options_calc_iv_cone",
        "options_get_sentiment_data",
        "futures_get_basis",
        "futures_get_supply_demand",
        "company_get_abnormal_operation",
        "company_get_bankruptcy_reorg",
        "company_get_default_info",
        "company_get_disciplinary_list",
        "company_get_discredit",
        "company_get_environment_penalty",
        "company_get_equity_pledged",
        "company_get_executed_persons",
        "company_get_final_case",
        "company_get_financial_leasing",
        "company_get_high_consumers",
        "company_get_illegal_dishonesty",
        "company_get_illegal_tax",
        "company_get_judicial_sales",
        "company_get_land_acquisition",
        "company_get_legal_notice",
        "company_get_owing_tax",
        "company_get_penalty_info",
        "company_get_share_lockup",
        "company_get_simple_cancellation",
        "company_get_tax_abnormal",
        "company_get_valuation_inquiry",
        "general_search_documents",
        "general_query_documents"
      ],
      "ordered_dates": [
        [
          "startDate",
          "endDate"
        ]
      ]
    },
    {
      "name": "time_from_to_order",
      "label": "司法时间区间",
      "tools": [
        "company_get_court_announcements",
        "company_get_court_sessions",
        "company_get_filing_info",
        "company_get_judgments",
        "company_get_news_sentiment"
      ],
      "ordered_dates": [
        [
          "timeFrom",
          "timeTo"
        ]
      ]
    },
    {
      "name": "futures_basis",
      "label": "期货基差",
      "tools": [
        "futures_get_basis"
      ],
      "paired": [
        [
          "startDate",
          "endDate"
        ]
      ],
      "required_one_of": [
        {
          "one_of": [
            [
              "windCodes"
            ],
            [
              "sector"
            ]
          ],
          "message": "futures_get_basis 必须提供 windCodes 或 sector 之一"
        }
      ]
    }
  ]
}
